{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits"],
  "schedule": ["before 6am on monday"],
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "description": "Go modules and the Go toolchain end up in the released binary: use fix(deps) so semantic-release publishes a patched release",
      "matchManagers": ["gomod"],
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Keep the Go toolchain in mise.toml and go.mod in lockstep, released like other runtime dependencies",
      "matchPackageNames": ["go", "golang"],
      "groupName": "Go toolchain",
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps"
    },
    {
      "description": "CI images don't affect the released binary",
      "matchManagers": ["gitlabci"],
      "semanticCommitType": "ci",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Developer tools (linters, CLIs) don't affect the released binary",
      "matchManagers": ["mise", "custom.regex"],
      "matchPackageNames": ["!go"],
      "semanticCommitType": "build",
      "semanticCommitScope": "deps"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "govulncheck version used by the `vuln` mise task",
      "managerFilePatterns": ["/^mise\\.toml$/"],
      "matchStrings": ["GOVULNCHECK_VERSION = \"(?<currentValue>v[^\"]+)\""],
      "depNameTemplate": "golang.org/x/vuln",
      "datasourceTemplate": "go"
    }
  ]
}
